@deftypefnx {} {@var{q} =} prctile (@var{x}, @var{p})
@deftypefnx {} {@var{q} =} prctile (@var{x}, @var{p}, @var{dim})
@deftypefnx {} {@var{q} =} prctile (@var{x}, @var{p}, @var{vecdim})
